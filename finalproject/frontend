<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Bike Rental Forecast</title>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>

    <style>
        body {
            font-family: Arial;
            margin: 0;
            background: linear-gradient(to right, #1c92d2, #f2fcfe);
        }

        .container {
            width: 750px;
            margin: 40px auto;
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 0 15px rgba(0,0,0,0.2);
        }

        h1 {
            text-align: center;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .full-width {
            grid-column: span 2;
        }

        input, select {
            width: 100%;
            padding: 8px;
        }

        button {
            width: 100%;
            padding: 12px;
            background: #1976d2;
            color: white;
            border: none;
            font-size: 16px;
            border-radius: 6px;
            cursor: pointer;
        }

        .result-box {
            margin-top: 30px;
            padding: 20px;
            background: #f7f7f7;
            border-radius: 10px;
            text-align: center;
        }
    </style>
</head>

<body>

<div class="container">
    <h1>🚲 Bike Rental Forecast</h1>

    <div class="form-grid">

        <div class="full-width">
            <label>Prediction Mode</label>
            <select id="mode">
                <option value="day">Day</option>
                <option value="hour">Hour</option>
            </select>
        </div>

        <div class="full-width">
            <label>Select Date</label>
            <input type="date" id="date">
        </div>

        <div>
            <label>Weather</label>
            <select id="weather">
                <option value="1">Clear</option>
                <option value="2">Mist</option>
                <option value="3">Light Rain</option>
                <option value="4">Heavy Rain</option>
            </select>
        </div>

        <div>
            <label>Temperature</label>
            <input type="range" min="0" max="1" step="0.01" id="temp">
        </div>

        <div>
            <label>Humidity</label>
            <input type="range" min="0" max="1" step="0.01" id="hum">
        </div>

        <div>
            <label>Windspeed</label>
            <input type="range" min="0" max="1" step="0.01" id="wind">
        </div>

        <div class="full-width">
            <label>Hour (for hour mode)</label>
            <select id="hour">
                <script>
                    for (let i = 0; i < 24; i++) {
                        document.write(`<option value="${i}">${i}:00</option>`);
                    }
                </script>
            </select>
        </div>

        <div class="full-width">
            <button onclick="predict()">Predict</button>
        </div>
    </div>
</div>

<div class="container result-box" id="result" style="display:none;">
    <h2>Prediction Result</h2>
    <canvas id="chart"></canvas>
</div>

<script>
function predict() {

    let labels = [];
    let values = [];

    let base = Math.floor(400 + Math.random() * 300);

    for (let i = 0; i < 6; i++) {
        labels.push("Step " + (i + 1));
        values.push(base + i * 30 + Math.floor(Math.random() * 30));
    }

    document.getElementById("result").style.display = "block";

    new Chart(document.getElementById("chart"), {
        type: "bar",
        data: {
            labels: labels,
            datasets: [{
                label: "Bike Rentals",
                data: values,
                backgroundColor: "#1976d2"
            }]
        },
        options: {
            plugins: {
                datalabels: {
                    anchor: 'end',
                    align: 'top',
                    color: 'black',
                    font: {
                        weight: 'bold'
                    }
                }
            }
        },
        plugins: [ChartDataLabels]
    });
}
</script>

</body>
</html>
